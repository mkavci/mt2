function saveSnapshot() {
    const clsText = document.getElementById('cls_select').selectedOptions[0].text;
    const skillText = document.getElementById('out_skill_title').innerText;
    const norm = document.getElementById('out_skill_norm').innerText;
    const crit = document.getElementById('out_skill_crit').innerText;
    const hit = document.getElementById('out_hit_norm').innerText;
    const hh = document.getElementById('bon_halfhuman').value;
    const skB = document.getElementById('bon_skill').value;

    snapshots.unshift({ clsText, skillText, norm, crit, hit, hh, skB });
    renderSnapshots();
}

function renderSnapshots() {
    const box = document.getElementById('snapshot_list');
    if (snapshots.length === 0) {
        box.innerHTML = `<div class="text-slate-600 italic">Henüz kıyaslama kaydı yok.</div>`;
        return;
    }
    box.innerHTML = snapshots.map((s, idx) => `
        <div class="bg-slate-900 p-2.5 rounded border border-slate-800">
            <div class="flex justify-between font-bold text-amber-400">
                <span>#${snapshots.length - idx} ${s.skillText}</span>
                <span class="text-[10px] text-slate-400">YI:%${s.hh} | Bec:%${s.skB}</span>
            </div>
            <div class="flex justify-between mt-1 text-slate-200">
                <span>Norm: <b>${s.norm}</b></span>
                <span>Kritik: <b class="text-amber-300">${s.crit}</b></span>
                <span>Düz: <b>${s.hit}</b></span>
            </div>
        </div>
    `).join('');
}

function clearSnapshots() {
    snapshots = [];
    renderSnapshots();
}

// ============================================================================
// 6. SUPABASE KAYIT VE OKUMA
// ============================================================================
async function saveToSupabase() {
    if (!sbClient) {
        alert("Supabase bağlantısı aktif değil. Kod içindeki SUPABASE_URL ve SUPABASE_ANON_KEY bilgilerini girin.");
        return;
    }
    const buildName = prompt("Bu efsun seti için bir başlık girin (Örn: Karabüyü 1-1 Full Küre Seti):");
    if (!buildName) return;

    const payload = {
        name: buildName,
        normal_dmg: `${document.getElementById('out_skill_title').innerText}: ${document.getElementById('out_skill_norm').innerText}`,
        crit_dmg: document.getElementById('out_skill_crit').innerText,
        data: {
            cls: document.getElementById('cls_select').value,
            spec: document.getElementById('spec_select').value,
            skill: document.getElementById('skill_select').value,
            grade: document.getElementById('skill_grade').value,
            halfhuman: document.getElementById('bon_halfhuman').value,
            skill_bon: document.getElementById('bon_skill').value
        }
    };

    const { error } = await sbClient.from('metin2_builds').insert([payload]);
    if (error) alert("Hata: " + error.message);
    else {
        alert("Senaryo buluta kaydedildi!");
        fetchCloudBuilds();
    }
}

async function fetchCloudBuilds() {
    if (!sbClient) return;
    const { data } = await sbClient.from('metin2_builds').select('*').order('created_at', { ascending: false }).limit(8);
    if (data) {
        document.getElementById('cloud_list').innerHTML = data.map(row => `
            <div class="bg-slate-900 p-3 rounded border border-slate-800">
                <div class="font-bold text-amber-400 truncate">${row.name}</div>
                <div class="text-slate-300 mt-1">${row.normal_dmg}</div>
                <div class="text-emerald-400 text-[11px]">Kritik: ${row.crit_dmg}</div>
            </div>
        `).join('');
    }
}

// Başlangıç
onClassChange();
renderSnapshots();
