<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Metin2 Pro PvP & Beceri Simülatörü (M/G/P Motoru)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        body { background-color: #070a12; color: #e2e8f0; font-family: 'Inter', 'Segoe UI', sans-serif; }
        .panel { background: #0f1626; border: 1px solid #1e293b; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.4); }
        .inp { background: #070a12; border: 1px solid #334155; color: #f8fafc; border-radius: 6px; padding: 6px 10px; width: 100%; font-size: 0.875rem; transition: border-color 0.2s; }
        .inp:focus { outline: none; border-color: #f59e0b; }
        .tab-btn { padding: 6px 12px; border-radius: 6px; font-size: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
        .tab-active { background: #f59e0b; color: #070a12; }
        .tab-inactive { background: #1e293b; color: #94a3b8; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #070a12; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    </style>
</head>
<body class="p-3 md:p-6">

<div class="max-w-[1440px] mx-auto">
    <!-- HEADER -->
    <header class="flex flex-col md:flex-row justify-between items-center mb-6 border-b border-slate-800 pb-4 gap-4">
        <div>
            <div class="flex items-center gap-3">
                <span class="bg-amber-500/10 text-amber-400 border border-amber-500/30 px-2.5 py-0.5 rounded text-xs font-bold tracking-wider">v2.5 ENGINE</span>
                <h1 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">METİN2 <span class="text-amber-500">PRO</span> HASAR & EFSUN SİMÜLATÖRÜ</h1>
            </div>
            <p class="text-slate-400 text-xs mt-1">Kaynak Kod Tabanlı (char_skill.cpp) Beceri (1-20 / M / G / P), Statü, Biyolog, Simya ve PvP Savunma Motoru</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <button onclick="saveSnapshot()" class="bg-indigo-600 hover:bg-indigo-500 text-white px-3.5 py-2 rounded-lg text-xs font-semibold transition">
                📸 Kıyaslamaya Ekle (A/B Test)
            </button>
            <button onclick="saveToSupabase()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-3.5 py-2 rounded-lg text-xs font-semibold transition">
                ☁️ Buluta Kaydet
            </button>
            <button onclick="location.reload()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 px-3.5 py-2 rounded-lg text-xs font-semibold transition">
                Sıfırla
            </button>
        </div>
    </header>

    <!-- ANA 3 SÜTUNLU YAPI -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">

        <!-- SOL SÜTUN: SALDIRAN KARAKTER & SKILL MOTORU (5 Kolon) -->
        <div class="lg:col-span-5 panel p-5 border-t-4 border-t-red-500 space-y-5">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h2 class="text-lg font-bold text-red-400">⚔️ SALDIRAN KARAKTER</h2>
                <span id="atk_power_badge" class="text-xs bg-red-500/10 text-red-300 border border-red-500/20 px-2 py-1 rounded">Efektif Saldırı: 0</span>
            </div>

            <!-- Sınıf ve Eğitim Seçimi -->
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs text-slate-400 mb-1">Karakter Sınıfı</label>
                    <select id="cls_select" class="inp font-semibold text-amber-400" onchange="onClassChange()">
                        <option value="warrior">Savaşçı (Warrior)</option>
                        <option value="ninja">Ninja (Assassin)</option>
                        <option value="sura">Sura</option>
                        <option value="shaman">Şaman (Shaman)</option>
                        <option value="lycan">Lycan</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1">Eğitim (Doktrin)</label>
                    <select id="spec_select" class="inp font-semibold" onchange="onSpecChange()"></select>
                </div>
            </div>

            <!-- Beceri ve Seviye (M / G / P) Seçimi -->
            <div class="bg-slate-900/90 p-3.5 rounded-lg border border-slate-800 space-y-3">
                <div class="grid grid-cols-12 gap-2 items-end">
                    <div class="col-span-7">
                        <label class="block text-xs text-amber-400 font-semibold mb-1">Test Edilecek Beceri (Skill)</label>
                        <select id="skill_select" class="inp" onchange="calculate()"></select>
                    </div>
                    <div class="col-span-5">
                        <label class="block text-xs text-amber-400 font-semibold mb-1">Beceri Seviyesi</label>
                        <select id="skill_grade" class="inp font-bold text-emerald-400" onchange="calculate()">
                            <option value="P" selected>P (Perfect Master)</option>
                            <option value="G10">G10 (Grand Master)</option>
                            <option value="G5">G5 (Grand Master)</option>
                            <option value="G1">G1 (Grand Master)</option>
                            <option value="M10">M10 (Master)</option>
                            <option value="M5">M5 (Master)</option>
                            <option value="M1">M1 (Master)</option>
                            <option value="15">Seviye 15</option>
                            <option value="1">Seviye 1</option>
                        </select>
                    </div>
                </div>

                <!-- Özel Durum Koşulları (Suikast Arkadan, Kritik Buff vb.) -->
                <div id="skill_modifiers" class="flex flex-wrap gap-3 pt-1 text-xs text-slate-300"></div>
            </div>

            <!-- Statüler (VIT, INT, STR, DEX) -->
            <div>
                <label class="block text-xs font-bold text-slate-300 mb-2 uppercase tracking-wider">Karakter Statüleri (İtemler Dahil Toplam)</label>
                <div class="grid grid-cols-4 gap-2">
                    <div>
                        <span class="text-[11px] text-slate-400">VIT (HP)</span>
                        <input type="number" id="stat_vit" value="90" class="inp text-center" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-[11px] text-slate-400">INT (SP)</span>
                        <input type="number" id="stat_int" value="90" class="inp text-center" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-[11px] text-slate-400">STR (Güç)</span>
                        <input type="number" id="stat_str" value="135" class="inp text-center" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-[11px] text-slate-400">DEX (Çevik)</span>
                        <input type="number" id="stat_dex" value="110" class="inp text-center" oninput="calculate()">
                    </div>
                </div>
            </div>

            <!-- Silah ve Temel Saldırı Değerleri -->
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs text-slate-400 mb-1">Karakter Ekranı Saldırı Değeri</label>
                    <input type="number" id="atk_phys_val" value="1650" class="inp" oninput="calculate()">
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1">Karakter Ekranı Büyülü Saldırı</label>
                    <input type="number" id="atk_mag_val" value="1150" class="inp" oninput="calculate()">
                </div>
            </div>

            <!-- Saldırı Efsunları -->
            <div>
                <label class="block text-xs font-bold text-slate-300 mb-2 uppercase tracking-wider">Saldırı Efsunları & Çarpanlar</label>
                <div class="grid grid-cols-3 gap-2.5 text-xs">
                    <div>
                        <span class="text-slate-400">Yarı İnsan (%)</span>
                        <input type="number" id="bon_halfhuman" value="65" class="inp" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-slate-400">Beceri Hasarı (%)</span>
                        <input type="number" id="bon_skill" value="25" class="inp" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-slate-400">Ortalama Zarar (%)</span>
                        <input type="number" id="bon_avg" value="45" class="inp" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-slate-400">Sınıfa Karşı Güç (%)</span>
                        <input type="number" id="bon_vs_class" value="35" class="inp" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-slate-400">Kritik Şansı (%)</span>
                        <input type="number" id="bon_crit" value="65" class="inp" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-slate-400">Delici Şansı (%)</span>
                        <input type="number" id="bon_pierce" value="55" class="inp" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-slate-400">Büyü Hızı (%)</span>
                        <input type="number" id="bon_cast" value="185" class="inp" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-slate-400">Saldırı Hızı (%)</span>
                        <input type="number" id="bon_aspd" value="165" class="inp" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-slate-400">Büyü Bozma (%)</span>
                        <input type="number" id="bon_antimagic" value="25" class="inp" oninput="calculate()">
                    </div>
                </div>
            </div>

            <!-- Biyolog & Simya & Ekstralar -->
            <div class="bg-slate-900/60 p-3 rounded-lg border border-slate-800 space-y-2">
                <label class="block text-xs font-bold text-amber-400 uppercase">Biyolog, Simya & Ekstra Çarpanlar</label>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <div>
                        <span class="text-slate-400">Biyolog (92/94 Seçimi)</span>
                        <select id="bio_choice" class="inp" onchange="calculate()">
                            <option value="str_str">Çift Saldırı Değeri (+111 STR/ATK)</option>
                            <option value="str_hp">Saldırı + HP (+51 ATK)</option>
                            <option value="hp_hp">Çift HP (Saldırı Bonusu Yok)</option>
                        </select>
                    </div>
                    <div>
                        <span class="text-slate-400">Simya Seti (Yakut & Elmas)</span>
                        <select id="alchemy_tier" class="inp" onchange="calculate()">
                            <option value="mythic_exc">Mitsi Kusursuz (+360 ATK, +18 Bec)</option>
                            <option value="mythic_bri">Mitsi Parlak (+270 ATK, +14 Bec)</option>
                            <option value="mythic_mat">Mitsi Mat (+180 ATK, +9 Bec)</option>
                            <option value="none">Simya Yok / Kapalı</option>
                        </select>
                    </div>
                </div>
                <div class="flex flex-wrap gap-4 pt-1 text-xs text-slate-300">
                    <label class="flex items-center gap-1.5 cursor-pointer">
                        <input type="checkbox" id="chk_nazar" checked onchange="calculate()" class="accent-amber-500"> Nazar/Kahramanlık (+%30 Hasar)
                    </label>
                    <label class="flex items-center gap-1.5 cursor-pointer">
                        <input type="checkbox" id="chk_atk_bone" onchange="calculate()" class="accent-amber-500"> Saldırı Kemiği / Şebnem (+200 ATK)
                    </label>
                </div>
            </div>
        </div>

        <!-- ORTA SÜTUN: SAVUNAN KARAKTER (RAKİP PROFİLİ) (4 Kolon) -->
        <div class="lg:col-span-4 panel p-5 border-t-4 border-t-blue-500 space-y-5">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h2 class="text-lg font-bold text-blue-400">🛡️ SAVUNAN (RAKİP)</h2>
                <select id="preset_enemy" class="bg-slate-800 text-xs text-slate-200 rounded px-2 py-1 border border-slate-700" onchange="applyEnemyPreset()">
                    <option value="custom">Hazır Rakip Şablonu Seç...</option>
                    <option value="duel_full">1-1 Full Savunmalı Düello Çarı</option>
                    <option value="war_tank">Lonca Savaşlık Tank (60-60-60)</option>
                    <option value="mid_player">Orta Seviye PvP Oyuncusu</option>
                </select>
            </div>

            <div class="grid grid-cols-2 gap-3 text-xs">
                <div>
                    <label class="block text-slate-400 mb-1">Rakip Sınıfı</label>
                    <select id="def_class" class="inp" onchange="calculate()">
                        <option value="warrior">Savaşçı</option>
                        <option value="ninja">Ninja</option>
                        <option value="sura">Sura</option>
                        <option value="shaman">Şaman</option>
                        <option value="lycan">Lycan</option>
                    </select>
                </div>
                <div>
                    <label class="block text-slate-400 mb-1">Rakip Maksimum HP</label>
                    <input type="number" id="def_hp" value="32000" class="inp" oninput="calculate()">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3 text-xs">
                <div>
                    <label class="block text-slate-400 mb-1">Fiziksel Savunma (Defans)</label>
                    <input type="number" id="def_armor" value="950" class="inp" oninput="calculate()">
                </div>
                <div>
                    <label class="block text-slate-400 mb-1">Büyü Savunması (Stat/Zırh)</label>
                    <input type="number" id="def_mdef" value="550" class="inp" oninput="calculate()">
                </div>
            </div>

            <!-- Efsun Savunmaları -->
            <div>
                <label class="block text-xs font-bold text-slate-300 mb-2 uppercase tracking-wider">Silah & Büyü Savunmaları (%)</label>
                <div class="grid grid-cols-2 gap-2.5 text-xs">
                    <div>
                        <span class="text-slate-400">Silah Savunması (Kılıç/Bıçak/Çan vb.)</span>
                        <input type="number" id="def_weapon" value="60" class="inp" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-slate-400">Büyü Dayanıklılığı (%)</span>
                        <input type="number" id="def_magic" value="55" class="inp" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-slate-400">Sınıf Savunması (Kalkan/Bilezik/Kemer)</span>
                        <input type="number" id="def_vs_class" value="40" class="inp" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-slate-400">Yarı İnsan Direnci (%)</span>
                        <input type="number" id="def_halfhuman" value="20" class="inp" oninput="calculate()">
                    </div>
                </div>
            </div>

            <!-- Hasar Azaltma & Dirençler -->
            <div>
                <label class="block text-xs font-bold text-slate-300 mb-2 uppercase tracking-wider">Özel Dirençler & Simya Savunması</label>
                <div class="grid grid-cols-2 gap-2.5 text-xs">
                    <div>
                        <span class="text-slate-400">Beceri Hasarına Karşı Koyma (%)</span>
                        <input type="number" id="def_skill_res" value="30" class="inp" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-slate-400">Ortalama Zarar Direnişi (%)</span>
                        <input type="number" id="def_avg_res" value="25" class="inp" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-slate-400">Yakın Dövüş Bloklama (%)</span>
                        <input type="number" id="def_block" value="40" class="inp" oninput="calculate()">
                    </div>
                    <div>
                        <span class="text-slate-400">Oklardan Korunma / Kaçınma (%)</span>
                        <input type="number" id="def_dodge" value="20" class="inp" oninput="calculate()">
                    </div>
                </div>
            </div>

            <!-- Rakip Savunma Buffları -->
            <div class="bg-slate-900/60 p-3 rounded-lg border border-slate-800 space-y-2 text-xs">
                <label class="block font-bold text-blue-400 uppercase">Rakip Aktif Koruma Skilleri</label>
                <div class="flex flex-col gap-2 text-slate-300">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="def_dark_prot" onchange="calculate()" class="accent-blue-500"> Karanlık Koruma (Karabüyü - Hasar Azaltma)
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="def_blessing" onchange="calculate()" class="accent-blue-500"> Kutsama (Ejderha Gücü - Fiziksel Azaltma)
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="def_def_bone" onchange="calculate()" class="accent-blue-500"> Savunma Kemiği / Biyolog Çift Savunma
                    </label>
                </div>
            </div>
        </div>

        <!-- SAĞ SÜTUN: ANALİZ, HASAR ÇIKTISI VE A/B KIYASLAMA (3 Kolon) -->
        <div class="lg:col-span-3 flex flex-col gap-5">
            <div class="panel p-5 border-t-4 border-t-amber-500 space-y-4">
                <h2 class="text-lg font-bold text-amber-400 border-b border-slate-800 pb-3">📊 SİMÜLASYON SONUCU</h2>

                <!-- Seçili Beceri Hasarı -->
                <div class="bg-slate-900 p-3.5 rounded-lg border border-slate-800">
                    <div class="flex justify-between items-center">
                        <span id="out_skill_title" class="text-xs font-bold text-amber-400 uppercase">SEÇİLİ BECERİ (P)</span>
                        <span id="out_skill_type_tag" class="text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-300">FİZİKSEL</span>
                    </div>
                    <div class="mt-2 flex items-baseline justify-between">
                        <span class="text-xs text-slate-400">Normal:</span>
                        <span id="out_skill_norm" class="text-2xl font-extrabold text-white">0</span>
                    </div>
                    <div class="mt-1 flex items-baseline justify-between">
                        <span class="text-xs text-amber-400">Kritik (2x):</span>
                        <span id="out_skill_crit" class="text-2xl font-extrabold text-amber-400">0</span>
                    </div>
                    <div class="mt-1 flex items-baseline justify-between border-t border-slate-800 pt-1">
                        <span class="text-xs text-emerald-400">Kritik + Delici:</span>
                        <span id="out_skill_pierce" class="text-lg font-bold text-emerald-400">0</span>
                    </div>
                </div>

                <!-- Düz Vuruş (Auto Attack) Hasarı -->
                <div class="bg-slate-900 p-3.5 rounded-lg border border-slate-800">
                    <span class="text-xs font-bold text-slate-300 uppercase">DÜZ VURUŞ (AUTO-ATTACK)</span>
                    <div class="mt-2 flex items-baseline justify-between">
                        <span class="text-xs text-slate-400">Normal Vuruş:</span>
                        <span id="out_hit_norm" class="text-lg font-bold text-white">0</span>
                    </div>
                    <div class="mt-1 flex items-baseline justify-between">
                        <span class="text-xs text-amber-400">Kritik + Delici:</span>
                        <span id="out_hit_crit_pierce" class="text-lg font-bold text-amber-400">0</span>
                    </div>
                </div>

                <!-- Detaylı Savaş Metrikleri -->
                <div class="space-y-2 text-xs pt-1">
                    <div class="flex justify-between">
                        <span class="text-slate-400">Beceri Dolum Süresi (CD):</span>
                        <span id="out_cd" class="font-bold text-slate-200">0.0 sn</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-400">Efektif Büyü Bozma Sonrası Savunma:</span>
                        <span id="out_eff_mdef" class="font-bold text-purple-400">%0</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-400">Rakibi Öldürme (Tahmini):</span>
                        <span id="out_ttk" class="font-bold text-red-400">0 Beceri</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-400">Ortalama Saniye Başına Hasar (DPS):</span>
                        <span id="out_dps" class="font-bold text-emerald-400">0 / sn</span>
                    </div>
                </div>
            </div>

            <!-- A/B Efsun Kıyaslama Kutusu -->
            <div class="panel p-4 flex-1">
                <div class="flex justify-between items-center mb-2">
                    <h3 class="text-xs font-bold text-indigo-400 uppercase">⚖️ Efsun / Set Kıyaslaması</h3>
                    <button onclick="clearSnapshots()" class="text-[11px] text-slate-500 hover:text-slate-300">Temizle</button>
                </div>
                <p class="text-[11px] text-slate-400 mb-3">Efsun değiştirmeden önce "Kıyaslamaya Ekle" butonuna basarak farkı görün.</p>
                <div id="snapshot_list" class="space-y-2 max-h-[260px] overflow-y-auto text-xs"></div>
            </div>
        </div>
    </div>

    <!-- SUPABASE BULUT KAYITLARI -->
    <div class="panel p-5 mt-5">
        <div class="flex justify-between items-center mb-3">
            <h3 class="text-sm font-bold text-slate-200">☁️ Buluta Kaydedilmiş Build & Efsun Senaryoları (Supabase)</h3>
            <span id="sb_status" class="text-xs text-slate-500">Bağlantı bekleniyor (Kod içindeki URL/Key alanını doldurun)</span>
        </div>
        <div id="cloud_list" class="grid grid-cols-1 md:grid-cols-4 gap-3 text-xs"></div>
    </div>
</div>

<script>
// ============================================================================
// 1. SUPABASE YAPILANDIRMASI
// ============================================================================
const SUPABASE_URL = 'https://qrjqaxylbunkcatepfoh.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_UBEUc4qiRfrPXgg1udc_4Q_2uzPU6gh';
let sbClient = null;

if (SUPABASE_URL.startsWith('http')) {
    sbClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    document.getElementById('sb_status').innerText = "Supabase Aktif";
    document.getElementById('sb_status').className = "text-xs text-emerald-400 font-semibold";
    fetchCloudBuilds();
}

// ============================================================================
// 2. METİN2 GERÇEK SINIF, EĞİTİM VE BECERİ VERİTABANI (char_skill.cpp)
// ============================================================================
// type: 'phys' (Fiziksel), 'magic' (Büyülü), 'ranged' (Ok/Menzilli)
// baseCd: Taban dolum süresi (sn)
// formula: (atk, mag, str, dex, int, vit, k) => ham beceri hasarı
const SKILL_DB = {
    warrior: {
        name: "Savaşçı",
        specs: {
            body: {
                name: "Bedensel Savaş",
