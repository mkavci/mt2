// ============================================================================
// 4. ANA HASAR HESAPLAMA MOTORU
// ============================================================================
function calculate() {
    const clsKey = document.getElementById('cls_select').value;
    const specKey = document.getElementById('spec_select').value;
    const skillKey = document.getElementById('skill_select').value;
    const grade = document.getElementById('skill_grade').value;
    const k = GRADE_K_MAP[grade] || 1.25;

    const skillObj = SKILL_DB[clsKey].specs[specKey].skills[skillKey];
    if (!skillObj) return;

    // Statüler
    const vit = parseFloat(document.getElementById('stat_vit').value) || 0;
    const int = parseFloat(document.getElementById('stat_int').value) || 0;
    const str = parseFloat(document.getElementById('stat_str').value) || 0;
    const dex = parseFloat(document.getElementById('stat_dex').value) || 0;

    // Temel Saldırı Değerleri + Biyolog + Simya + Aktif Bufflar
    let physAtk = parseFloat(document.getElementById('atk_phys_val').value) || 0;
    let magAtk = parseFloat(document.getElementById('atk_mag_val').value) || 0;

    // Biyolog Etkisi
    const bio = document.getElementById('bio_choice').value;
    if (bio === 'str_str') physAtk += 111;
    else if (bio === 'str_hp') physAtk += 51;

    // Simya Etkisi (Yakut & Elmas)
    const alch = document.getElementById('alchemy_tier').value;
    let alchSkillBon = 0;
    let alchAvgBon = 0;
    if (alch === 'mythic_exc') { physAtk += 360; magAtk += 180; alchSkillBon = 18; alchAvgBon = 18; }
    else if (alch === 'mythic_bri') { physAtk += 270; magAtk += 135; alchSkillBon = 14; alchAvgBon = 14; }
    else if (alch === 'mythic_mat') { physAtk += 180; magAtk += 90; alchSkillBon = 9; alchAvgBon = 9; }

    // Karakter Kendine Özel Saldırı Buffları
    if (document.getElementById('mod_aura')?.checked) physAtk += 550;
    if (document.getElementById('mod_blade')?.checked) physAtk += 620;
    if (document.getElementById('mod_crimson')?.checked) physAtk += 650;
    if (document.getElementById('chk_atk_bone').checked) { physAtk += 200; magAtk += 100; }

    document.getElementById('atk_power_badge').innerText = `Efektif ATK: ${Math.round(physAtk)} | Büyü: ${Math.round(magAtk)}`;

    // Saldırı Bonusları
    const halfHuman = parseFloat(document.getElementById('bon_halfhuman').value) || 0;
    const skillBon = (parseFloat(document.getElementById('bon_skill').value) || 0) + alchSkillBon;
    const avgBon = (parseFloat(document.getElementById('bon_avg').value) || 0) + alchAvgBon;
    const vsClass = parseFloat(document.getElementById('bon_vs_class').value) || 0;
    const critChance = Math.min(100, parseFloat(document.getElementById('bon_crit').value) || 0);
    const pierceChance = Math.min(100, parseFloat(document.getElementById('bon_pierce').value) || 0);
    const castSpeed = parseFloat(document.getElementById('bon_cast').value) || 100;
    const antiMagic = Math.min(50, parseFloat(document.getElementById('bon_antimagic').value) || 0);
    const hasNazar = document.getElementById('chk_nazar').checked ? 1.30 : 1.0;

    // Rakip Savunma Verileri
    const defHp = parseFloat(document.getElementById('def_hp').value) || 1;
    let defArmor = parseFloat(document.getElementById('def_armor').value) || 0;
    let defMdef = parseFloat(document.getElementById('def_mdef').value) || 0;
    const defWeapon = Math.min(95, parseFloat(document.getElementById('def_weapon').value) || 0);
    const defMagic = Math.min(95, parseFloat(document.getElementById('def_magic').value) || 0);
    const defVsClass = Math.min(90, parseFloat(document.getElementById('def_vs_class').value) || 0);
    const defHalfHuman = Math.min(90, parseFloat(document.getElementById('def_halfhuman').value) || 0);
    const defSkillRes = Math.min(90, parseFloat(document.getElementById('def_skill_res').value) || 0);
    const defAvgRes = Math.min(90, parseFloat(document.getElementById('def_avg_res').value) || 0);
    const defBlock = Math.min(90, parseFloat(document.getElementById('def_block').value) || 0);
    const defDodge = Math.min(90, parseFloat(document.getElementById('def_dodge').value) || 0);

    if (document.getElementById('def_def_bone').checked) { defArmor += 300; defMdef += 150; }

    // 1. HAM BECERİ HASARI HESAPLAMA
    let rawSkill = skillObj.calc(physAtk, magAtk, str, dex, int, vit, k);

    // Suikast Özel Çarpanları
    if (skillObj.hasBackstab) {
        if (document.getElementById('mod_backstab')?.checked) rawSkill *= 1.20;
        if (document.getElementById('mod_stealth')?.checked) rawSkill *= 1.55;
    }

    // Ortak Saldırı Çarpanları (Yarı İnsan, Sınıf Gücü, Beceri Hasarı, Nazar)
    const netHalfHuman = Math.max(0, halfHuman - defHalfHuman);
    const netVsClass = Math.max(0, vsClass - defVsClass);

    rawSkill = rawSkill * (1 + netHalfHuman / 100) * (1 + netVsClass / 100) * (1 + skillBon / 100) * hasNazar;

    // 2. SAVUNMA KESİNTİLERİ (Beceri Türüne Göre)
    let finalSkillDmg = 0;
    let effectiveMagicDef = defMagic;

    if (skillObj.type === 'phys' || skillObj.type === 'ranged') {
        let afterArmor = Math.max(50, rawSkill - (defArmor * 0.85));
        let weaponOrDodge = skillObj.type === 'ranged' ? Math.min(95, defWeapon + (defDodge * 0.4)) : defWeapon;
        finalSkillDmg = afterArmor * (1 - weaponOrDodge / 100) * (1 - defSkillRes / 100);
    } else if (skillObj.type === 'magic') {
        // Büyü Bozma (Anti-Magic) rakibin büyü savunmasını kırar
        effectiveMagicDef = Math.max(0, defMagic * (1 - antiMagic / 100));
        let afterMdef = Math.max(50, rawSkill - (defMdef * 0.75));
        finalSkillDmg = afterMdef * (1 - effectiveMagicDef / 100) * (1 - defSkillRes / 100);
    } else if (skillObj.type === 'magic_true') {
        // Büyü Çözme büyü savunmasından etkilenmez, sadece beceri direnci ve karanlık korumadan etkilenir
        finalSkillDmg = rawSkill * (1 - defSkillRes / 100);
    }

    // Rakip Aktif Koruma Skilleri (Karanlık Koruma / Kutsama)
    if (document.getElementById('def_dark_prot').checked) finalSkillDmg *= 0.68; // ~%32 hasar azaltma
    if (document.getElementById('def_blessing').checked && (skillObj.type === 'phys' || skillObj.type === 'ranged')) {
        finalSkillDmg *= 0.72;
    }

    // Kritik ve Delici Beceri Sonuçları
    const skillNorm = Math.round(finalSkillDmg);
    const skillCrit = Math.round(finalSkillDmg * 2);
    const pierceExtra = (skillObj.type === 'phys' || skillObj.type === 'ranged') ? (defArmor * 0.85 * (1 - defWeapon / 100)) : (defMdef * 0.75 * (1 - effectiveMagicDef / 100));
    const skillCritPierce = Math.round(skillCrit + pierceExtra);

    // 3. DÜZ VURUŞ (AUTO-ATTACK) HESAPLAMA
    let rawHit = physAtk * (1 + netHalfHuman / 100) * (1 + netVsClass / 100) * (1 + avgBon / 100) * hasNazar;
    let hitAfterArmor = Math.max(20, rawHit - defArmor);
    let finalHit = hitAfterArmor * (1 - defWeapon / 100) * (1 - defAvgRes / 100);
    if (document.getElementById('def_dark_prot').checked) finalHit *= 0.68;
    if (document.getElementById('def_blessing').checked) finalHit *= 0.70;

    const hitNorm = Math.round(finalHit);
    const hitCritPierce = Math.round((finalHit * 2) + (defArmor * (1 - defWeapon / 100)));

    // 4. METRİKLER (CD, TTK, DPS)
    const actualCd = (skillObj.cd / (castSpeed / 100)).toFixed(1);
    const avgSkill = (skillNorm * (1 - critChance / 100)) + (skillCrit * (critChance / 100));
    const ttk = Math.ceil(defHp / Math.max(1, avgSkill));
    const dps = Math.round(avgSkill / Math.max(0.5, parseFloat(actualCd)));

    // EKRANA YAZDIR
    document.getElementById('out_skill_title').innerText = `${skillObj.name} (${grade})`;
    document.getElementById('out_skill_type_tag').innerText = skillObj.type === 'magic' ? 'BÜYÜLÜ' : (skillObj.type === 'ranged' ? 'MENZİLLİ' : 'FİZİKSEL');
    document.getElementById('out_skill_norm').innerText = skillNorm.toLocaleString('tr-TR');
    document.getElementById('out_skill_crit').innerText = skillCrit.toLocaleString('tr-TR');
    document.getElementById('out_skill_pierce').innerText = skillCritPierce.toLocaleString('tr-TR');

    document.getElementById('out_hit_norm').innerText = hitNorm.toLocaleString('tr-TR');
    document.getElementById('out_hit_crit_pierce').innerText = hitCritPierce.toLocaleString('tr-TR');

    document.getElementById('out_cd').innerText = `${actualCd} sn`;
    document.getElementById('out_eff_mdef').innerText = `%${Math.round(effectiveMagicDef)}`;
    document.getElementById('out_ttk').innerText = `${ttk} Beceri`;
    document.getElementById('out_dps').innerText = `${dps.toLocaleString('tr-TR')} / sn`;
}

